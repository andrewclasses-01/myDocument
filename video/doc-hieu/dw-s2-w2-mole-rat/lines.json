[
 {
  "id": "v1",
  "text": "Look at this little animal.",
  "slide": 1
 },
 {
  "id": "v2",
  "text": "It is a mole rat.",
  "slide": 1
 },
 {
  "id": "v3",
  "text": "It has no fur.",
  "slide": 1
 },
 {
  "id": "v4",
  "text": "And it lives underground.",
  "slide": 1
 },
 {
  "id": "v5",
  "text": "No fur, and a home under the ground?",
  "slide": 1
 },
 {
  "id": "v6",
  "text": "That is strange!",
  "slide": 1
 },
 {
  "id": "v7",
  "text": "Look at these three pictures.",
  "slide": 2
 },
 {
  "id": "v8",
  "text": "The first one shows its look, it looks like a rat.",
  "slide": 2
 },
 {
  "id": "v9",
  "text": "The other two show bees and ants.",
  "slide": 2
 },
 {
  "id": "v10",
  "text": "It looks like a rat, but it lives like bees or ants.",
  "slide": 2
 },
 {
  "id": "v11",
  "text": "Now look at its mouth.",
  "slide": 3
 },
 {
  "id": "v12",
  "text": "It has very sharp teeth, at the front of its mouth.",
  "slide": 3
 },
 {
  "id": "v13",
  "text": "Two teeth on top.",
  "slide": 3
 },
 {
  "id": "v14",
  "text": "Two teeth on the bottom.",
  "slide": 3
 },
 {
  "id": "v15",
  "text": "That is four sharp teeth.",
  "slide": 3
 },
 {
  "id": "v16",
  "text": "Look, there are many mole rats here.",
  "slide": 4
 },
 {
  "id": "v17",
  "text": "They live together in tunnels under the ground.",
  "slide": 4
 },
 {
  "id": "v18",
  "text": "Remember the bees and ants?",
  "slide": 4
 },
 {
  "id": "v19",
  "text": "They live in a big group, too.",
  "slide": 4
 },
 {
  "id": "v20",
  "text": "Only one mole rat has babies.",
  "slide": 5
 },
 {
  "id": "v21",
  "text": "She is the queen.",
  "slide": 5
 },
 {
  "id": "v22",
  "text": "Look at this big number.",
  "slide": 5
 },
 {
  "id": "v23",
  "text": "She can have up to one hundred babies a year!",
  "slide": 5
 },
 {
  "id": "v24",
  "text": "See her tiny babies all around her?",
  "slide": 5
 },
 {
  "id": "v25",
  "text": "You just met the queen.",
  "slide": 6
 },
 {
  "id": "v26",
  "text": "Who helps her?",
  "slide": 6
 },
 {
  "id": "v27",
  "text": "The other mole rats bring food to her.",
  "slide": 6
 },
 {
  "id": "v28",
  "text": "They keep her safe.",
  "slide": 6
 },
 {
  "id": "v29",
  "text": "And they care for her babies.",
  "slide": 6
 },
 {
  "id": "v30",
  "text": "All mole rats have a job.",
  "slide": 7
 },
 {
  "id": "v31",
  "text": "Some are small, some are big, and some are the biggest.",
  "slide": 7
 },
 {
  "id": "v32",
  "text": "Each size has one job.",
  "slide": 7
 },
 {
  "id": "v33",
  "text": "Let's look at each size.",
  "slide": 7
 },
 {
  "id": "v34",
  "text": "First, the small mole rats.",
  "slide": 8
 },
 {
  "id": "v35",
  "text": "Look at the first picture, they find food, so the group can eat.",
  "slide": 8
 },
 {
  "id": "v36",
  "text": "In the second, they keep the tunnel clean, so it is a good home.",
  "slide": 8
 },
 {
  "id": "v37",
  "text": "Now compare these two.",
  "slide": 9
 },
 {
  "id": "v38",
  "text": "Which one is bigger?",
  "slide": 9
 },
 {
  "id": "v39",
  "text": "The big mole rats dig.",
  "slide": 9
 },
 {
  "id": "v40",
  "text": "The biggest mole rats keep everyone safe, even the queen.",
  "slide": 9
 },
 {
  "id": "v41",
  "text": "Look at this long tunnel.",
  "slide": 10
 },
 {
  "id": "v42",
  "text": "The mole rat is eating a root.",
  "slide": 10
 },
 {
  "id": "v43",
  "text": "Mole rats dig and dig.",
  "slide": 10
 },
 {
  "id": "v44",
  "text": "Why? Scientists think they look for roots to eat.",
  "slide": 10
 },
 {
  "id": "v45",
  "text": "It is only an idea, not a sure fact.",
  "slide": 10
 },
 {
  "id": "v46",
  "text": "Today, you can see some mole rats in zoos.",
  "slide": 11
 },
 {
  "id": "v47",
  "text": "So, why are they strange?",
  "slide": 11
 },
 {
  "id": "v48",
  "text": "They have no fur, they live like bees, and their queen has one hundred babies a year!",
  "slide": 11
 },
 {
  "id": "v49",
  "text": "Small, but very strange!",
  "slide": 11
 }
]